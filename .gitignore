.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.env.*
!.env.example
*.log
*.tmp
*.bak

# Secrets, credentials, and private keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.enc
*credentials*
*credential*
*secrets*
*secret*

# Local artifacts and large generated outputs
corpus/raw_repos/*
corpus/mined/*
corpus/processed/*
results/logs/*
results/metrics/*
results/predictions/*
results/figures/*
tokenizer/*

# Large datasets, archives, model weights, and checkpoints
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
checkpoints/*
results/checkpoints/*

# Keep placeholder files so empty directories stay in Git
!corpus/raw_repos/.gitkeep
!corpus/mined/.gitkeep
!corpus/processed/.gitkeep
!corpus/manifests/.gitkeep
!results/logs/.gitkeep
!results/metrics/.gitkeep
!results/predictions/.gitkeep
!results/figures/.gitkeep
!tokenizer/.gitkeep
